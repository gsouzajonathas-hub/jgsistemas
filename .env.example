# ===== Banco de dados =====
# Para PostgreSQL (Docker/hospedagem) com senha SEM caracteres especiais:
# DATABASE_URL=postgresql://escola_user:escola_pass_2024@localhost:5432/escola_ingles
#
# RECOMENDADO (senha com caracteres especiais, ex. Supabase com `/ ^ *`):
# Essas duas variáveis NÃO podem entrar numa connection string
# `postgresql://user:senha@host/db` — quebra o parsing da URL e a autenticação falha.
# Use o bloco PG* abaixo (a senha é passada crua, sem re-parse da URL):
# PGHOST=aws-0-us-west-2.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.<ref>
# PGPASSWORD=<senha-com-caracteres-especiais>
# PGDATABASE=postgres
#
# Para SQLite (padrão local): o caminho é montado em DATA_DIR/escola.db.
# Também aceita caminho explícito: DATABASE_URL=sqlite:///C:/caminho/escola.db

# ===== Diretórios de dados (dados do cliente fora do código) =====
# Onde fica o escola.db (default: pasta backend/)
DATA_DIR=
# Onde ficam uploads/logos (default: backend/uploads)
UPLOAD_DIR=

# ===== Segurança =====
# OBRIGATÓRIO: chave forte. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Ambiente: "development" (docs habilitados) ou "production" (docs ocultos, headers reforçados)
ENVIRONMENT=development

# ===== Email transacional =====
# Preferencial: Resend (usado em produção). Crie a key em https://resend.com/api-keys
# e verifique o remetente (RESEND_FROM) no domínio em https://resend.com/domains
RESEND_API_KEY=
RESEND_FROM=

# Fallback: SMTP (usado somente se RESEND_API_KEY/FROM estiverem vazios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== WhatsApp (Z-API) =====
# Ex.: ZAPI_INSTANCE_URL=https://api.z-api.io/instances/{seu-id}/token/{seu-token}
ZAPI_INSTANCE_URL=
ZAPI_TOKEN=

# ===== Frontend =====
# URL pública do frontend (usada nos links de redefinição de senha)
FRONTEND_URL=http://localhost:5173
